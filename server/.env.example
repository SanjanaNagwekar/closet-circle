# Runtime database file. In a deployed environment, place this on a persistent disk.
DATABASE_PATH=./data/closet-circle.db

# Comma-separated browser origins permitted to call the API directly.
CLIENT_ORIGINS=http://localhost:3000

# Optional: seed an empty database when index.js starts directly.
SEED_DATABASE_ON_START=false

PORT=8800
HOST=127.0.0.1
