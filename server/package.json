{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-database.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-database.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-database.js",
    "db:reset": "node --env-file-if-exists=.env scripts/reset-database.js && node --env-file-if-exists=.env scripts/setup-database.js",
    "test": "node --test test/*.test.js",
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "multer": "^2.5.0",
    "nodemon": "^3.1.9",
    "sqlite3": "^5.1.7"
  }
}
