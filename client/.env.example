# Copy this file to .env.local and fill in your Auth0 application values.
# Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Server-only origin used by Next.js to proxy /backend-api/* requests.
# In production, set this to the deployed Express service origin.
API_BASE_URL=http://127.0.0.1:8800
